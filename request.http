}

### Password settings
GET {{baseUrl}}/settings/password
Accept: text/html

### MUTATING: password update route (invalid confirmation leaves credentials unchanged; expected 422)
PUT {{baseUrl}}/settings/password
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "current_password": "{{password}}",
  "password": "DoNotChange123!",
  "password_confirmation": "different-value"
}

### Appearance settings
GET {{baseUrl}}/settings/appearance
Accept: text/html

### Password confirmation page
GET {{baseUrl}}/user/confirm-password
Accept: text/html

### Confirm password; unlocks password.confirm protected 2FA routes for this session
POST {{baseUrl}}/user/confirm-password
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "password": "{{password}}"
}

### Confirmed-password status
GET {{baseUrl}}/user/confirmed-password-status
Accept: application/json

### Two-factor settings page
GET {{baseUrl}}/settings/two-factor
Accept: text/html

### MUTATING: enable two-factor authentication
POST {{baseUrl}}/user/two-factor-authentication
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Two-factor QR code (available after enable)
GET {{baseUrl}}/user/two-factor-qr-code
Accept: application/json

### Two-factor secret key (available after enable)
GET {{baseUrl}}/user/two-factor-secret-key
Accept: application/json

### Two-factor recovery codes (available after confirmation)
GET {{baseUrl}}/user/two-factor-recovery-codes
Accept: application/json

### Confirm two-factor setup (replace with the authenticator code; 422 for placeholder)
POST {{baseUrl}}/user/confirmed-two-factor-authentication
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "code": "000000"
}

### Regenerate two-factor recovery codes (requires confirmed 2FA)
POST {{baseUrl}}/user/two-factor-recovery-codes
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### MUTATING: disable two-factor authentication (returns account to original state)
DELETE {{baseUrl}}/user/two-factor-authentication
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Signed email verification route (intentionally invalid signature; expected 403)
GET {{baseUrl}}/verify-email/{{verificationUserId}}/{{verificationHash}}?signature=invalid
Accept: text/html

### Email verification notice (verified seeded user redirects to dashboard)
GET {{baseUrl}}/verify-email
Accept: text/html

### Send verification notification (verified seeded user sends nothing)
POST {{baseUrl}}/email/verification-notification
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Remove cart item after checkout test (may return 400 if checkout already closed the cart)
DELETE {{baseUrl}}/cart/items/{{cartItemId}}
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Logout
POST {{baseUrl}}/logout
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Create a disposable user (run after logout; timestamp keeps the email unique)
# @name registerDisposable
POST {{baseUrl}}/register
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "HTTP Smoke Test",
  "email": "http-smoke-{{$timestamp}}@example.test",
  "password": "Temporary123!",
  "password_confirmation": "Temporary123!"
}

### DESTRUCTIVE: delete only the disposable user created immediately above
DELETE {{baseUrl}}/settings/profile
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "password": "Temporary123!"
}
