### Pehlione route smoke tests
### JetBrains HTTP Client: run requests one-by-one, or run a section in order.
### Cookies are retained automatically. Mutating/destructive calls are marked clearly.

@baseUrl = http://localhost:8000
@email = admin@pehlione.com
@password = D0cker
@productSlug = breathe-comfort-ergonomic-chair
@productSize = M
@cartItemId = 1
@orderId = 1
@mailLogId = 1
@documentationSection = getting-started
@documentationDocument = installation
@storagePath = example.txt
@resetToken = example-token
@verificationUserId = 1
@verificationHash = example-hash

### Health check
GET {{baseUrl}}/up
Accept: text/plain

### Swagger UI
GET {{baseUrl}}/swagger
Accept: text/html

### OpenAPI document
GET {{baseUrl}}/openapi.yaml
Accept: application/yaml

### Home
GET {{baseUrl}}/
Accept: text/html

### About
GET {{baseUrl}}/about
Accept: text/html

### Connection
GET {{baseUrl}}/connection
Accept: text/html

### Product catalogue
GET {{baseUrl}}/products
Accept: text/html

### Product detail (slug route binding)
GET {{baseUrl}}/products/{{productSlug}}
Accept: text/html

### Public storage route (replace storagePath with an existing storage/app/public file)
GET {{baseUrl}}/storage/{{storagePath}}

### Registration page
GET {{baseUrl}}/register
Accept: text/html

### Login page + initialize the session/XSRF cookie
GET {{baseUrl}}/login
Accept: text/html

> {%
const cookie = response.headers.valuesOf('Set-Cookie')
    .find((value) => value.startsWith('XSRF-TOKEN='));
const match = cookie && cookie.match(/^XSRF-TOKEN=([^;]+)/);
client.test('XSRF cookie is present', function () {
    client.assert(match, 'The login page did not set XSRF-TOKEN');
});
if (match) client.global.set('csrfToken', decodeURIComponent(match[1]));
%}

### Forgot-password page
GET {{baseUrl}}/forgot-password
Accept: text/html

### Send password reset mail (writes a message to MailHog)
POST {{baseUrl}}/forgot-password
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "email": "{{email}}"
}

### Reset-password page (an intentionally invalid token only checks route reachability)
GET {{baseUrl}}/reset-password/{{resetToken}}?email={{email}}
Accept: text/html

### Reset password (intentionally invalid token; expected 422)
POST {{baseUrl}}/reset-password
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "token": "example-token",
  "email": "{{email}}",
  "password": "Temporary123!",
  "password_confirmation": "Temporary123!"
}

### Two-factor challenge page (normally reached after a 2FA login)
GET {{baseUrl}}/two-factor-challenge
Accept: text/html

### Two-factor challenge submit (expected 422 without a pending 2FA login)
POST {{baseUrl}}/two-factor-challenge
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "code": "000000"
}

### Login as a verified seeded admin
# @name login
POST {{baseUrl}}/login
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "email": "{{email}}",
  "password": "{{password}}",
  "remember": false
}

### Dashboard
GET {{baseUrl}}/dashboard
Accept: text/html

### Documentation index
GET {{baseUrl}}/docs
Accept: text/html

### Documentation section
GET {{baseUrl}}/docs/{{documentationSection}}
Accept: text/html

### Documentation document
GET {{baseUrl}}/docs/{{documentationSection}}/{{documentationDocument}}
Accept: text/html

### Cart page as Inertia JSON; captures the first cart item when available
# @name cart
GET {{baseUrl}}/cart
Accept: application/json
X-Inertia: true

> {%
if (response.body.props.cart.items.length > 0) {
    client.global.set('cartItemId', response.body.props.cart.items[0].id);
}
%}

### Add a product to the cart
POST {{baseUrl}}/cart/items
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "product_slug": "{{productSlug}}",
  "size": "{{productSize}}",
  "quantity": 1
}

### Refresh cart and capture cartItemId after adding
GET {{baseUrl}}/cart
Accept: application/json
X-Inertia: true

> {%
client.test('cart contains at least one item', function () {
    client.assert(response.body.props.cart.items.length > 0, 'No cart item was returned');
});
client.global.set('cartItemId', response.body.props.cart.items[0].id);
%}

### Update cart item
PATCH {{baseUrl}}/cart/items/{{cartItemId}}
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "quantity": 2
}

### Checkout page
GET {{baseUrl}}/checkout
Accept: text/html

### Checkout preview
POST {{baseUrl}}/checkout/preview
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "shipping_address": { "country": "DE" },
  "discount_code": null
}

### Create an order; captures orderId from the redirect Location
# @name checkout
POST {{baseUrl}}/checkout
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "shipping_address": {
    "label": "HTTP test",
    "first_name": "Ada",
    "last_name": "Lovelace",
    "line1": "Teststrasse 1",
    "postal_code": "10115",
    "city": "Berlin",
    "country": "DE",
    "set_as_default_shipping": false
  },
  "billing_address": { "same_as_shipping": true },
  "payment_method": "card",
  "notes": "Created by request.http"
}

> {%
const location = response.headers.valueOf('Location');
const match = location && location.match(/\/checkout\/confirmation\/(\d+)/);
if (match) client.global.set('orderId', match[1]);
%}

### Checkout confirmation
GET {{baseUrl}}/checkout/confirmation/{{orderId}}
Accept: text/html

### Mark order prepared (requires a warehouse/admin role and a valid orderId)
POST {{baseUrl}}/orders/{{orderId}}/prepare
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{}

### Mark order shipped (requires a warehouse/admin role and a prepared order)
POST {{baseUrl}}/orders/{{orderId}}/ship
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "tracking_number": "HTTP-TEST-{{$timestamp}}"
}

### Mail activity page
GET {{baseUrl}}/dashboard/mail
Accept: text/html

### Mark a mail log as read (replace mailLogId with an existing ID)
POST {{baseUrl}}/dashboard/mail/{{mailLogId}}/read
Accept: application/json
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{}

### DESTRUCTIVE: delete a mail log (replace mailLogId with an expendable ID)
DELETE {{baseUrl}}/dashboard/mail/{{mailLogId}}
Accept: application/json
X-XSRF-TOKEN: {{csrfToken}}

### Settings redirect
GET {{baseUrl}}/settings
Accept: text/html

